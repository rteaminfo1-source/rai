# Rai (Apache) — необязательно: данные и так защищены (data/*.php)
Options -Indexes
DirectoryIndex index.html
RedirectMatch 404 ^/data(/|$)

# Нейросеть на процессоре в несколько потоков (в 3–6 раз быстрее): изоляция страницы.
# Внешние картинки, шрифты и вход через Google продолжают работать (режим credentialless).
<IfModule mod_headers.c>
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Embedder-Policy "credentialless"
</IfModule>
