<?xml version="1.0" encoding="UTF-8"?>
<!-- Rai (IIS/Windows) — необязательно. На Apache используется .htaccess. -->
<configuration>
  <system.webServer>
    <defaultDocument><files><clear /><add value="index.html" /></files></defaultDocument>
    <directoryBrowse enabled="false" />
    <security>
      <requestFiltering><hiddenSegments><add segment="data" /></hiddenSegments></requestFiltering>
    </security>
  </system.webServer>
</configuration>
