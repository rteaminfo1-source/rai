# Rai работает без внешних API — ключи не нужны.

# Адрес(а) вашего сайта через запятую, чтобы только он мог обращаться к Rai.
# Пример: https://rteam.info,https://www.rteam.info  (по умолчанию * — все сайты)
ALLOWED_ORIGINS=*

# Версия по умолчанию: pro | pro-fast | pro-plus | pro-sun
RAI_DEFAULT_VERSION=pro

# Секрет для /api/teach (обучение новым ответам). Пусто — обучение выключено.
RAI_ADMIN_TOKEN=

# Часовой пояс для «который час»
RAI_TZ=Europe/Moscow

# Необязательно
# RAI_MAX_MESSAGE_CHARS=4000
# RAI_KNOWLEDGE_PATH=knowledge.json
# RAI_LEARNED_PATH=learned.json
