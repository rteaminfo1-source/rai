# Rai: ИИ-движок свой, ключей для него не нужно.
# Погода, валюты, перевод и поиск берутся из бесплатных открытых сервисов без ключей.

# ---- Вход через Google ----
GOOGLE_CLIENT_ID=40211315152-jq7a91jcqrpu8hkmlqmg1poh6bthgs5j.apps.googleusercontent.com
# Секрет вставляйте ТОЛЬКО в панели хостинга или в свой .env на сервере. В GitHub — никогда.
GOOGLE_CLIENT_SECRET=
# По умолчанию https://<ваш-сервер>/auth/google/callback — этот адрес добавьте в Google Cloud Console.
# GOOGLE_REDIRECT_URI=https://rai-xxxx.onrender.com/auth/google/callback

# Ключ подписи сессий (любая длинная случайная строка). Пусто — создастся в data/secret_key.
RAI_SECRET_KEY=
# Папка для пользователей и их чатов
# RAI_DATA_DIR=data

# Адрес(а) сайта через запятую, которым можно обращаться к API Rai (по умолчанию * — всем)
ALLOWED_ORIGINS=*

# Версия по умолчанию: pro | pro-fast | pro-plus | pro-sun
RAI_DEFAULT_VERSION=pro
# Город для «какая погода» без названия города
RAI_DEFAULT_CITY=Москва
RAI_TZ=Europe/Moscow

# Секрет для /api/teach (обучение новым ответам). Пусто — обучение выключено.
RAI_ADMIN_TOKEN=
