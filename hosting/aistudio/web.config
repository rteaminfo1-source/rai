<?xml version="1.0" encoding="UTF-8"?>
<!-- AI Studio Rteam (для хостинга на IIS/Windows). На Apache используется .htaccess. -->
<configuration>
  <system.webServer>
    <defaultDocument>
      <files><clear /><add value="index.php" /><add value="index.html" /></files>
    </defaultDocument>
    <directoryBrowse enabled="false" />
    <security>
      <requestFiltering>
        <hiddenSegments><add segment="data" /></hiddenSegments>
        <fileExtensions>
          <add fileExtension=".json" allowed="false" />
          <add fileExtension=".lock" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>
  </system.webServer>
  <location path="sites">
    <system.webServer>
      <handlers accessPolicy="Read" />
    </system.webServer>
  </location>
</configuration>
