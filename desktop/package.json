{
  "name": "rai-desktop",
  "productName": "Rai",
  "version": "1.0.0",
  "description": "Rai — свой ИИ-помощник команды Rteam: чат, нейросеть, код, презентации",
  "homepage": "https://rai.rteam.info",
  "author": {
    "name": "Rteam",
    "email": "rteam.info1@gmail.com"
  },
  "license": "UNLICENSED",
  "main": "main.js",
  "scripts": {
    "prepare-offline": "node scripts/prepare.js",
    "start": "npm run prepare-offline && electron .",
    "dist": "npm run prepare-offline && electron-builder",
    "dist:win": "npm run prepare-offline && electron-builder --win",
    "dist:mac": "npm run prepare-offline && electron-builder --mac",
    "dist:linux": "npm run prepare-offline && electron-builder --linux"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "info.rteam.rai",
    "productName": "Rai",
    "copyright": "© Rteam",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "offline",
        "to": "offline"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "rteaminfo1-source",
        "repo": "rai",
        "releaseType": "release"
      },
      {
        "provider": "generic",
        "url": "https://rai.rteam.info/app/"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Rai-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Rai",
      "uninstallDisplayName": "Rai",
      "menuCategory": "Rteam",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "license": "build/license.txt",
      "include": "build/installer.nsh",
      "warningsAsErrors": false,
      "language": "1049"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "artifactName": "Rai-mac-${arch}.${ext}",
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Rai слушает микрофон, когда вы говорите голосом.",
        "NSCameraUsageDescription": "Камера нужна, только если вы сами её включите."
      }
    },
    "dmg": {
      "title": "Rai"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Utility",
      "synopsis": "Свой ИИ-помощник команды Rteam",
      "maintainer": "Rteam <rteam.info1@gmail.com>",
      "executableName": "rai",
      "syncDesktopName": true
    },
    "deb": {
      "packageName": "rai",
      "artifactName": "Rai-linux.deb"
    },
    "appImage": {
      "artifactName": "Rai-linux.AppImage"
    }
  },
  "desktopName": "rai.desktop"
}
