# Rai: ИИ-движок свой, ключей для него не нужно.
# Погода, валюты, перевод и поиск берутся из бесплатных открытых сервисов без ключей.

# Регистрация, вход и Google — на основном сайте rteam.info (папка hosting/rteam.info), не здесь.

# Адрес(а) сайта через запятую, которым можно обращаться к API Rai (по умолчанию * — всем)
ALLOWED_ORIGINS=*

# Версия по умолчанию: pro | pro-fast | pro-plus | pro-sun | pro-quasar
RAI_DEFAULT_VERSION=pro
# Город для «какая погода» без названия города
RAI_DEFAULT_CITY=Москва
RAI_TZ=Europe/Moscow

# Секрет для /api/teach (обучение новым ответам). Пусто — обучение выключено.
RAI_ADMIN_TOKEN=
