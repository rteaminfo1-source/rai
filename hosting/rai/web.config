<?xml version="1.0" encoding="UTF-8"?>
<!-- Rai (IIS/Windows) — необязательно. На Apache используется .htaccess. -->
<configuration>
  <system.webServer>
    <defaultDocument><files><clear /><add value="index.html" /></files></defaultDocument>
    <directoryBrowse enabled="false" />
    <!-- нейросеть на процессоре в несколько потоков: изоляция страницы -->
    <httpProtocol><customHeaders>
      <add name="Cross-Origin-Opener-Policy" value="same-origin" />
      <add name="Cross-Origin-Embedder-Policy" value="credentialless" />
    </customHeaders></httpProtocol>
    <security>
      <requestFiltering><hiddenSegments><add segment="data" /></hiddenSegments></requestFiltering>
    </security>
  </system.webServer>
</configuration>
