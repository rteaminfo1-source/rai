<?xml version="1.0" encoding="UTF-8"?>
<!-- Rteam — основной сайт (для хостинга на IIS/Windows). На Apache используется .htaccess. -->
<configuration>
  <system.webServer>
    <defaultDocument>
      <files><clear /><add value="index.php" /></files>
    </defaultDocument>
    <directoryBrowse enabled="false" />
    <security>
      <requestFiltering>
        <hiddenSegments><add segment="data" /></hiddenSegments>
        <fileExtensions>
          <add fileExtension=".json" allowed="false" />
          <add fileExtension=".lock" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
